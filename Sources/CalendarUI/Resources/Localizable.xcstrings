    "This is a repeating event. Change which events?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este evento se repite. ¿Qué eventos quieres cambiar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet événement se répète. Quels événements modifier ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein wiederholter Termin. Welche Termine ändern?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo evento si ripete. Quali eventi vuoi modificare?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este evento se repete. Quais eventos alterar?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een herhalende afspraak. Welke afspraken wijzigen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは繰り返しの予定です。どの予定を変更しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복 일정입니다. 어떤 일정을 변경하시겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是重复日程。要更改哪些日程？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是重複行程。要更改哪些行程？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это повторяющееся событие. Какие события изменить?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا حدث متكرر. أي الأحداث تريد تغييرها؟"
          }
        }
      }
    },
    "This is a repeating event. Delete which events?": {
      "localizations": {
        "es": {
