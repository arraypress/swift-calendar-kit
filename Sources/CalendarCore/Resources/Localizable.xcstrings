{
  "sourceLanguage": "en",
  "strings": {
    "%@: cancelled, so it was left out": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: cancelado, así que se omitió"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : annulé, il a donc été ignoré"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: abgesagt, daher ausgelassen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: annullato, quindi è stato escluso"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: cancelado, por isso foi omitido"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: geannuleerd, dus weggelaten"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：キャンセル済みのため除外しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 취소되어 제외했습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：已取消，因此未导入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：已取消，因此未匯入"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: отменено, поэтому пропущено"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: أُلغي، لذا تم تجاهله"
          }
        }
      }
    },
    "%@: its repeat rule could not be used (%@), so it was imported as a single event": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: no se pudo usar su regla de repetición (%@), así que se importó como un evento único"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : sa règle de répétition n’a pas pu être utilisée (%@), il a donc été importé comme événement unique"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Die Wiederholungsregel konnte nicht verwendet werden (%@), daher als einzelner Termin importiert"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: la regola di ripetizione non è utilizzabile (%@), quindi è stato importato come evento singolo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: a regra de repetição não pôde ser usada (%@), então foi importado como evento único"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: de herhaalregel kon niet worden gebruikt (%@), dus als losse afspraak geïmporteerd"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：繰り返しルールを使用できないため（%@）、単独の予定として読み込みました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 반복 규칙을 사용할 수 없어(%@) 단일 일정으로 가져왔습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：无法使用其重复规则（%@），因此作为单个日程导入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：無法使用其重複規則（%@），因此以單一行程匯入"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: правило повторения не поддерживается (%@), поэтому импортировано как одно событие"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: تعذّر استخدام قاعدة التكرار (%@)، لذا استُورد كحدث واحد"
          }
        }
      }
    },
    "%@: no readable start time, so it was left out": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: sin hora de inicio legible, así que se omitió"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : heure de début illisible, il a donc été ignoré"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: keine lesbare Startzeit, daher ausgelassen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: orario di inizio non leggibile, quindi è stato escluso"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: horário de início ilegível, por isso foi omitido"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: geen leesbare begintijd, dus weggelaten"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：開始時刻を読み取れないため除外しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 시작 시간을 읽을 수 없어 제외했습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：无法读取开始时间，因此未导入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：無法讀取開始時間，因此未匯入"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: не удалось прочитать время начала, поэтому пропущено"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: تعذّرت قراءة وقت البدء، لذا تم تجاهله"
          }
        }
      }
    },
